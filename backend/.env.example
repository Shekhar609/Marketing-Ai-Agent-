# ==============================================================================
# Autonomous Agentic AI Marketing Platform - Environment Configuration
# ==============================================================================

PROJECT_NAME="Autonomous Agentic AI Marketing & Revenue Operations Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# API Configuration
API_V1_PREFIX="/api/v1"
SECRET_KEY="aipnt-super-secure-production-jwt-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL 16 + pgvector)
# Live PostgreSQL with pgvector
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/marketing_platform"
# For Docker internal network:
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@db:5432/marketing_platform"
# For offline fallback SQLite:
# DATABASE_URL="sqlite+aiosqlite:///./marketing_platform.db"

# Redis & Cache
REDIS_URL="redis://localhost:6379/0"

# LLM Providers (Google Gemini, OpenAI, Anthropic, Local)
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_LLM_MODEL="gemini-1.5-flash"
CHEAP_LLM_MODEL="gpt-4o-mini"
REASONING_LLM_MODEL="gpt-4o"
GEMINI_FLASH_MODEL="gemini-1.5-flash"
GEMINI_PRO_MODEL="gemini-1.5-pro"

# Security & Guardrails
ENABLE_TENANT_ISOLATION=true
REQUIRE_APPROVAL_HIGH_RISK=true

# Real Salesforce CRM Integration
SALESFORCE_INSTANCE_URL=""
SALESFORCE_ACCESS_TOKEN=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
SALESFORCE_SECURITY_TOKEN=""

# Real Slack Workspace Integration
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
SLACK_DEFAULT_CHANNEL="#growth-alerts"

# Real Calendar & Meeting Booking (Calendly / Google Calendar)
CALENDLY_API_KEY=""
GOOGLE_CALENDAR_TOKEN=""

